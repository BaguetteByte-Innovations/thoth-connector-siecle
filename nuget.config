<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone NuGet source list for the public Thoth repositories.
  <clear /> first so the build does NOT depend on the host machine's global sources
  (which may lack nuget.org), then add nuget.org. This makes the public repos resolve
  Thoth.Integration.Abstractions + MinVer reproducibly on any machine.
-->
<configuration>
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>
	<fallbackPackageFolders>
		<clear />
	</fallbackPackageFolders>
</configuration>
