<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <!-- Dépôt public autonome : publish/siecle/ à la racine du dépôt (ignoré par git).
         Monorepo : directement dans le dossier connectors-ext du moteur, où il est découvert. -->
    <PublishDir Condition="'$(ThothStandalone)' == 'true'">$(MSBuildProjectDirectory)\publish\siecle\</PublishDir>
    <PublishDir Condition="'$(ThothStandalone)' != 'true'">$(MSBuildThisFileDirectory)..\..\..\Thoth.Engine\bin\x64\Release\net10.0-windows\win-x64\connectors-ext\siecle\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
